# Copy to .env (git-ignored). Reference for env vars Keystone reads.

# --- origin: storage ---
DATABASE_URL=postgres://keystone:keystone_dev_pw@localhost:5432/keystone
REDIS_URL=redis://localhost:6379/0

# ORIGIN_ADDR=:8080

# --- origin: capability signing (optional) ---
# Generate a keypair with: go run ./cmd/keygen
# The PRIVATE key is secret — never commit it. The signer id is embedded
# in every token this node mints.
KEYSTONE_SIGNING_PRIVATE_KEY=paste-base64url-private-key-here
KEYSTONE_SIGNER_ID=keystone-dev

# --- edge ---
# Already set in wrangler.jsonc; override with `wrangler dev --var ...`.
# ORIGIN_URL=http://localhost:8080
