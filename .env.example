# Copy to .env (git-ignored) and tweak locally.
# Reference for which env vars each Keystone service reads.

# --- origin ---
# When set, origin uses Postgres; when unset, origin uses the in-memory store.
# Matches docker-compose.yml credentials.
DATABASE_URL=postgres://keystone:keystone_dev_pw@localhost:5432/keystone

# When set, origin wraps the store with a Redis look-aside cache.
# Without REDIS_URL, origin reads straight from Postgres on every request.
REDIS_URL=redis://localhost:6379/0

# Address the origin HTTP server binds to. Default: :8080
# ORIGIN_ADDR=:8080

# --- edge ---
# Already set in wrangler.jsonc; override with `wrangler dev --var ORIGIN_URL=...` if needed.
# ORIGIN_URL=http://localhost:8080
