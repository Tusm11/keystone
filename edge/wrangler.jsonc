{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keystone-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    // URL of the Go origin API. In local dev, Wrangler forwards localhost
    // traffic from the Worker to the host. In prod, override with the
    // deployed origin's URL.
    "ORIGIN_URL": "http://localhost:8080"
  },
  "kv_namespaces": [
    {
      // Edge-local cache for code → long_url. Replicated to every Cloudflare
      // PoP; eventually consistent (seconds to minutes to converge globally).
      //
      // In local dev, Wrangler emulates this with Miniflare — no cloud setup
      // needed. For production, create a real namespace with:
      //   wrangler kv namespace create LINKS
      // and paste the returned id into the "id" field below.
      "binding": "LINKS",
      "id": "keystone-links-local"
    }
  ]
}
